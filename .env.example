# Plasmic Studio
# ID do projeto "NOCS Lab Site"
# Necessário apenas para npm run codegen.
PLASMIC_PROJECT_ID=

# Host usado pelo Codegen e pela autenticacao.
# Local: http://localhost:3003
# SaaS:  https://studio.plasmic.app
PLASMIC_HOST=

# Build estatica
# Deixe vazio para servir na raiz.
# Para GitHub Pages em /nocs-lab-site/, use /nocs-lab-site.
# Esta variavel nao envia credenciais ao navegador.
NEXT_PUBLIC_BASE_PATH=
