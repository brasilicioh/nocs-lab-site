# Crie este arquivo como .env.local e preencha com os dados do projeto no Plasmic.
# O token do Loader é usado no navegador e deve ser tratado como público.
NEXT_PUBLIC_PLASMIC_PROJECT_ID=
NEXT_PUBLIC_PLASMIC_PROJECT_TOKEN=
# PROJECT_ID pode ser pego na url do plasmic, por exemplo: https://studio.plasmic.app/projects/frXqmNDHgks3HdiZSfe5R5/-/Homepage?arena_type=page&arena=kAGwtq5UTh8F
# PROJECT_TOKEN pode ser pego no Plasmic Studio, em "Code"; topo do modal

# Para um Studio local, use http://localhost:3003. Deixe vazio para Plasmic Cloud.
NEXT_PUBLIC_PLASMIC_HOST=
